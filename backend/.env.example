# .env (Untuk Produksi di Azure VM)

# --- Konfigurasi Aplikasi Umum ---
APP_NAME="HRIS CMLABS" # Tetap sesuai nama aplikasi Anda
APP_ENV=production    # <--- PENTING: Harus 'production' untuk keamanan dan kinerja
APP_KEY= # <--- PENTING: Harus digenerate! Jalankan 'php artisan key:generate' di VM Anda
APP_DEBUG=false       # <--- PENTING: Selalu 'false' di produksi untuk keamanan
APP_URL=https://hris-cmlabs.indonesiacentral.cloudapp.azure.com # <--- PENTING: Sesuaikan dengan URL HTTPS publik aplikasi Anda

LOG_CHANNEL=stack
LOG_LEVEL=error       # <--- Sesuaikan: 'error' atau 'critical' untuk log yang lebih ringkas di produksi
LOG_STDERR_FORMATTER=null

# --- Konfigurasi Database (MySQL) ---
# Asumsi MySQL Anda berjalan di VM yang sama.
# Jika Anda menggunakan Azure Database for MySQL, DB_HOST akan menjadi server name-nya.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1     # <--- Jika MySQL di VM yang sama, tetap '127.0.0.1'
DB_PORT=3306
DB_DATABASE=hris_cmlabs
DB_USERNAME=your_db_username # <--- PENTING: Ganti dengan username database yang kuat
DB_PASSWORD="your_strong_db_password" # <--- PENTING: Ganti dengan password database yang kuat dan kompleks!

# --- Konfigurasi Laravel Sanctum (untuk autentikasi SPA/API) ---
# SANCTUM_STATEFUL_DOMAINS harus mencakup domain frontend Next.js Anda (tanpa protokol).
# Ini penting untuk cookies CORS dari Sanctum.
SANCTUM_STATEFUL_DOMAINS=hris-cmlabs.indonesiacentral.cloudapp.azure.com # <--- Sesuaikan dengan domain frontend Anda
SANCTUM_GUARD=web

# --- Konfigurasi Sesi ---
SESSION_DRIVER=database # 'database' adalah pilihan yang aman. 'redis' lebih baik untuk skala besar.
SESSION_LIFETIME=120    # <--- Sesuaikan: Durasi sesi dalam menit (misal 120 menit = 2 jam)
SESSION_ENCRYPT=true    # <--- PENTING: Enkripsi sesi untuk keamanan
SESSION_PATH=/
SESSION_DOMAIN=hris-cmlabs.indonesiacentral.cloudapp.azure.com # <--- PENTING: Sesuaikan dengan domain utama aplikasi Anda
SESSION_SECURE_COOKIE=true # <--- PENTING: Wajib 'true' jika Anda menggunakan HTTPS

# --- Konfigurasi Cache & Queue ---
CACHE_STORE=file        # 'file' adalah default. 'redis' disarankan untuk kinerja dan skalabilitas.
# CACHE_PREFIX= (Tidak perlu diubah kecuali Anda punya kebutuhan khusus)

QUEUE_CONNECTION=sync   # 'sync' untuk eksekusi instan. 'database' atau 'redis' untuk background processing.
                        # Jika pakai 'database', pastikan jalankan 'php artisan queue:work'

# --- Konfigurasi Redis (Disarankan untuk Cache, Session, Queue) ---
# Jika Anda menggunakan Redis (baik yang diinstal di VM atau Azure Cache for Redis)
# Jika tidak menggunakan Redis, Anda bisa hapus/biarkan ini dan gunakan driver 'file'/'database'
REDIS_CLIENT=phpredis   # Atau 'predis' jika Anda menginstal driver tersebut
REDIS_HOST=127.0.0.1    # <--- Jika Redis di VM yang sama, tetap '127.0.0.1'
REDIS_PASSWORD=null     # Ganti 'null' jika Redis Anda memiliki password
REDIS_PORT=6379

# --- Konfigurasi Mail (Wajib disesuaikan untuk email asli) ---
# 'log' hanya untuk development. Di produksi, gunakan layanan SMTP sungguhan.
MAIL_MAILER=smtp        # <--- PENTING: Ganti ke 'smtp'
MAIL_HOST=smtp.mailgun.org # <--- Contoh: Host SMTP penyedia layanan email Anda (misal: smtp.sendgrid.net, smtp.mailgun.org)
MAIL_PORT=587           # <--- Contoh: Port SMTP (umumnya 587 atau 465 untuk SSL)
MAIL_USERNAME=your_mail_username # <--- PENTING: Ganti dengan username SMTP Anda
MAIL_PASSWORD="your_mail_password" # <--- PENTING: Ganti dengan password SMTP Anda
MAIL_ENCRYPTION=tls     # <--- Contoh: 'tls' atau 'ssl'
MAIL_FROM_ADDRESS="no-reply@hris-cmlabs.indonesiacentral.cloudapp.azure.com" # <--- PENTING: Ganti dengan alamat email pengirim yang valid
MAIL_FROM_NAME="${APP_NAME}"

# --- Konfigurasi AWS (Jika tidak menggunakan S3 atau layanan AWS lainnya, bisa dihapus/dibiarkan kosong) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Konfigurasi Vite (Frontend) ---
# Ini biasanya diakses oleh frontend (Next.js Anda)
VITE_APP_NAME="${APP_NAME}"
# VITE_APP_URL= (Tambahkan jika Anda butuh URL aplikasi di Vite/Frontend)

# --- Tambahan untuk Storage Link (jika menggunakan disk lokal/public storage) ---
# Pastikan ini dijalankan setelah deployment: php artisan storage:link
# APP_STORAGE_URL= (Opsional, jika Anda menyajikan storage/app/public melalui URL publik)
