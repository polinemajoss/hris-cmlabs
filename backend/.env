APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:Cjf/RYEM1/XyDpa71zBRuHz9sxF9k+uIC29KC8LwYzM=
APP_DEBUG=true
APP_URL=http://localhost:8000 # <-- Sudah benar, ini URL backend lokal Anda

ASSET_URL=${APP_URL}

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

AUTH_ENABLED=false

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1 # <-- Sudah benar, menunjuk ke MySQL lokal Anda
DB_PORT=3306      # <-- Sudah benar, port default MySQL
DB_DATABASE=hris_cmlabs # <-- PASTIKAN DATABASE INI ADA DI MySQL LOKAL ANDA
DB_USERNAME=root  # <-- PASTIKAN USERNAME INI SESUAI
DB_PASSWORD=      # <-- PASTIKAN PASSWORD INI SESUAI (biarkan kosong jika tidak ada)

SANCTUM_STATEFUL_DOMAINS=http://localhost:3000,127.0.0.1:3000 # <-- Sudah benar, ini domain frontend Anda
SESSION_DOMAIN=localhost # <-- Sudah benar untuk sesi lokal
SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log # <-- Mengirim email ke log file, bagus untuk lokal
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID= # <-- Biarkan kosong jika tidak menggunakan AWS S3/SES
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=your-google-client-id # <-- Ganti jika Anda menggunakan Google OAuth
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback # <-- Ganti jika ada path callback yang berbeda